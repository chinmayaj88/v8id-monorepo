{
  "info": {
    "_postman_id": "files-folders-v2",
    "name": "Files and Folders API",
    "description": "File and folder management API for v8id-cloud.\n\n**Features:**\n- Single/Multiple file upload (up to 100MB)\n- Chunked upload (up to 5GB) with pause/resume/cancel\n- Folder operations with tree structure\n- Universal search\n- User access sharing by email",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. File Upload",
      "item": [
        {
          "name": "Single File Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "folderId", "value": "", "type": "text" },
                { "key": "name", "value": "", "type": "text" },
                { "key": "description", "value": "", "type": "text" },
                { "key": "storageTier", "value": "STANDARD", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          }
        },
        {
          "name": "Multiple Files Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [] },
                { "key": "folderId", "value": "", "type": "text" },
                { "key": "storageTier", "value": "STANDARD", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload-multiple",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload-multiple"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Chunked Upload",
      "item": [
        {
          "name": "Initiate Upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"large-file.mp4\",\n  \"fileSize\": 1073741824,\n  \"mimeType\": \"video/mp4\",\n  \"folderId\": null,\n  \"storageTier\": \"STANDARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "initiate"]
            }
          }
        },
        {
          "name": "Upload Chunk",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "chunk", "type": "file", "src": [] },
                { "key": "chunkNumber", "value": "1", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/chunk/:sessionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "chunk", ":sessionId"],
              "variable": [{ "key": "sessionId", "value": "" }]
            }
          }
        },
        {
          "name": "Resume Upload (Get Progress)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/:sessionId/resume",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ":sessionId", "resume"],
              "variable": [{ "key": "sessionId", "value": "" }]
            }
          }
        },
        {
          "name": "Complete Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/:sessionId/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ":sessionId", "complete"],
              "variable": [{ "key": "sessionId", "value": "" }]
            }
          }
        },
        {
          "name": "Cancel Upload",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/:sessionId/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ":sessionId", "cancel"],
              "variable": [{ "key": "sessionId", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. File List & Search",
      "item": [
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files?folderId=&type=&status=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files"],
              "query": [
                { "key": "folderId", "value": "" },
                { "key": "type", "value": "" },
                { "key": "status", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Universal Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/search?q=test&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "search"],
              "query": [
                { "key": "q", "value": "test" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Trash",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/trash",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "trash"]
            }
          }
        }
      ]
    },
    {
      "name": "4. File Operations",
      "item": [
        {
          "name": "Get File Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Download File",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "download"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Preview File",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "preview"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Update File",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"renamed-file.txt\",\n  \"description\": \"Updated\",\n  \"folderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Delete File (Soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Delete File (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "permanent"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Restore File",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "restore"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "5. Folder Operations",
      "item": [
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Folder\",\n  \"parentId\": null,\n  \"description\": \"\",\n  \"color\": \"#FF5733\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders"]
            }
          }
        },
        {
          "name": "Get Folder Contents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/contents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "contents"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Get Folder Path (Breadcrumbs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/path",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "path"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Update Folder",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed Folder\",\n  \"color\": \"#33FF57\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Delete Folder (Soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Delete Folder (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "permanent"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Restore Folder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "restore"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "6. Sharing",
      "item": [
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/users/search?q=john@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "users", "search"],
              "query": [{ "key": "q", "value": "john@example.com" }]
            }
          }
        },
        {
          "name": "Share by Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"file-id-here\",\n  \"folderId\": null,\n  \"email\": \"user@example.com\",\n  \"permission\": \"VIEW\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "share"]
            }
          }
        },
        {
          "name": "List My Shares",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/shares",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "shares"]
            }
          }
        },
        {
          "name": "List Shared With Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/shared-with-me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "shared-with-me"]
            }
          }
        },
        {
          "name": "Remove Share",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/shares/:shareId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "shares", ":shareId"],
              "variable": [{ "key": "shareId", "value": "" }]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" }
  ]
}
