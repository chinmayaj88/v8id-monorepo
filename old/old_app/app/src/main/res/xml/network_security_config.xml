<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
        DEVELOPMENT CONFIG: Allow cleartext (HTTP) traffic for ALL domains
        This is the same config that worked in your test project.
        WARNING: This should be disabled in production builds!
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
