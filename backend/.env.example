# Database Configuration
# MySQL connection string for local development (Docker)
DATABASE_URL="mysql://v8id_user:v8id_password@localhost:3306/v8id_cloud?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# OCI (Oracle Cloud Infrastructure) Configuration
# Uncomment and fill in when deploying to OCI
# OCI_REGION=us-ashburn-1
# OCI_TENANCY_OCID=
# OCI_USER_OCID=
# OCI_FINGERPRINT=
# OCI_PRIVATE_KEY_PATH=
# OCI_COMPARTMENT_OCID=
# OCI_BUCKET_NAME=v8id-cloud-storage
# OCI_NAMESPACE=

# Authentication & Security
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# JWT_EXPIRES_IN=7d
# SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# File Upload Configuration
# MAX_FILE_SIZE=10737418240
# ALLOWED_FILE_TYPES=*

# Logging
# LOG_LEVEL=debug