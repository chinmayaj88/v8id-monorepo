# Server Configuration
PORT=4000
NODE_ENV=development

# Trust Proxy Configuration
# Options:
#   - "false" or unset: Disable trust proxy (default, secure for local dev)
#   - "1": Trust first proxy (e.g., single Nginx/Cloudflare)
#   - "true": Trust all proxies (INSECURE - only use in trusted networks)
#   - Number string (e.g., "2"): Trust N number of proxies in chain
TRUST_PROXY=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000


# Database Configuration
DATABASE_URL="mysql://v8id_user:v8id_password@localhost:3306/v8id_cloud?schema=public"




# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Configuration 
BCRYPT_ROUNDS=12

# TOTP (Two-Factor Authentication) Configuration
TOTP_ENCRYPTION_KEY=your-totp-encryption-key-change-in-production-min-32-chars
TOTP_ISSUER=v8id-cloud


# Email Configuration

# Provider options: 'resend' (production) or 'console' (development)
EMAIL_PROVIDER=console

# Resend Email Service (required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=your-resend-api-key-here

# Email sender address
# For testing: onboarding@resend.dev (works without domain verification)
# For production: use your verified domain (e.g., noreply@yourdomain.com)
EMAIL_FROM=noreply@v8id.cloud

# Frontend URL (used in email links like password reset)
FRONTEND_URL=http://localhost:3000


# OCI (Oracle Cloud Infrastructure) Configuration
OCI_TENANCY_ID=ocid1.tenancy.oc1..your-tenancy-ocid
OCI_USER_ID=ocid1.user.oc1..your-user-ocid
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=C:\Users\username\.oci\oci_api_key.pem
OCI_REGION=ap-mumbai-1

# OCI Object Storage Configuration
OCI_OBJECT_STORAGE_NAMESPACE=your-oci-namespace
OCI_OBJECT_STORAGE_BUCKET_NAME=v8id-files


# Admin User Configuration (for seed script)
ADMIN_EMAIL=admin@v8id.cloud
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User


# Optional Configuration


# File Upload Configuration
# Maximum file size in bytes (default: 10MB per Express limit)
# MAX_FILE_SIZE=10485760

# Allowed file types (use '*' for all types, or comma-separated MIME types)
# ALLOWED_FILE_TYPES=*

# Logging Configuration
# LOG_LEVEL=debug
