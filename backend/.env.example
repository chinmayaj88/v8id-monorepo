# Database Configuration
# MySQL connection string for local development (Docker)
DATABASE_URL="mysql://v8id_user:v8id_password@localhost:3306/v8id_cloud?schema=public"

# Alternative database configuration (if not using connection string)
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=v8id_user
# DATABASE_PASSWORD=v8id_password
# DATABASE_NAME=v8id_cloud

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Admin User Configuration (for seed script)
ADMIN_EMAIL=admin@v8id.cloud
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Email Configuration
# Provider options: 'resend' (production) or 'console' (development)
EMAIL_PROVIDER=console
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=noreply@v8id.cloud
FRONTEND_URL=http://localhost:3000

# OCI (Oracle Cloud Infrastructure) Configuration
# OCI authentication uses ConfigFileAuthenticationDetailsProvider
# Ensure ~/.oci/config is set up with proper credentials
# See: https://docs.oracle.com/en-us/iaas/Content/API/Concepts/sdkconfig.htm

# OCI Object Storage Configuration (for file management)
# Required for file upload/download functionality
OCI_OBJECT_STORAGE_NAMESPACE=your-oci-namespace
OCI_OBJECT_STORAGE_BUCKET_NAME=v8id-files

# OCI Region (optional - for future OCI services)
# OCI_REGION=us-ashburn-1

# Authentication & Security
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Configuration
BCRYPT_ROUNDS=12

# TOTP (Two-Factor Authentication) Configuration
TOTP_ENCRYPTION_KEY=your-totp-encryption-key-change-in-production-min-32-chars
TOTP_ISSUER=v8id-cloud

# File Upload Configuration
# Maximum file size in bytes (default: 100MB = 104857600)
# MAX_FILE_SIZE=104857600

# Allowed file types (use '*' for all types, or comma-separated MIME types)
# ALLOWED_FILE_TYPES=*

# Logging Configuration
# LOG_LEVEL=debug
