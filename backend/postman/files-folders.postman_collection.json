{
  "info": {
    "_postman_id": "files-folders-collection",
    "name": "Files & Folders",
    "description": "File and folder management endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Universal Search",
      "item": [
        {
          "name": "Unified Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/search?q=test&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "search"],
              "query": [
                { "key": "q", "value": "test" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Folders",
      "item": [
        {
          "name": "List Folders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders?parentFolderId=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders"]
            }
          }
        },
        {
          "name": "Create Folder",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data) {",
                  "        pm.environment.set(\"folderId\", jsonData.data.id);",
                  "        console.log(\"✅ folderId saved to environment\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Folder\",\n  \"parentFolderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders"]
            }
          }
        },
        {
          "name": "Get Folder Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Update Folder",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed Folder\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Trash/Delete Folder",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Files",
      "item": [
        {
          "name": "List Files",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data && jsonData.data.length > 0) {",
                  "        pm.environment.set(\"fileId\", jsonData.data[0].id);",
                  "        console.log(\"✅ First fileId saved to environment for testing\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "folderId", "value": "" },
                { "key": "type", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get File Meta",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Update File",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Filename.pdf\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Delete File (Trash)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Restore File",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "restore"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Permanent Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "permanent"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Single Upload",
      "item": [
        {
          "name": "Standard Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data) {",
                  "        pm.environment.set(\"fileId\", jsonData.data.id);",
                  "        console.log(\"✅ fileId saved to environment\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "folderId", "value": "", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Multiple & Chunked Upload",
      "item": [
        {
          "name": "1. Initiate Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data) {",
                  "        pm.environment.set(\"uploadSessionId\", jsonData.data.sessionId);",
                  "        console.log(\"✅ uploadSessionId saved to environment\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"large-video.mp4\",\n  \"fileSize\": 50000000,\n  \"mimeType\": \"video/mp4\",\n  \"folderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "initiate"]
            }
          }
        },
        {
          "name": "2. Upload Chunk",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "sessionId", "value": "{{uploadSessionId}}" },
                { "key": "chunkNumber", "value": "0" },
                { "key": "chunk", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/chunk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "chunk"]
            }
          }
        },
        {
          "name": "3. Complete Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data) {",
                  "        pm.environment.set(\"fileId\", jsonData.data.id);",
                  "        pm.environment.unset(\"uploadSessionId\");",
                  "        console.log(\"✅ fileId saved to environment and session cleared\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/:sessionId/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ":sessionId", "complete"],
              "variable": [{ "key": "sessionId", "value": "{{uploadSessionId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "6. Sharing & Public Links",
      "item": [
        {
          "name": "Internal Share",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"target-user-id\",\n  \"permission\": \"VIEW\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "share"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Generate Public Link",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/link",
