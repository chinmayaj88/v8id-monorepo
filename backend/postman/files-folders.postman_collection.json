    {
      "name": "8. Bulk Operations",
      "item": [
        {
          "name": "Bulk Delete",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileIds\": [\"id1\", \"id2\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/bulk/delete",
