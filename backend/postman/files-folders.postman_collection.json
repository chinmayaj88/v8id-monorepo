              "path": ["api", "files", ":id", "link"],
              "variable": [{ "key": "id", "value": "" }]
            }
          }
        },
        {
          "name": "Public Redirect Access",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/link/:token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "link", ":token"],
              "variable": [{ "key": "token", "value": "" }]
            }
          }
        }
      ]
    },
