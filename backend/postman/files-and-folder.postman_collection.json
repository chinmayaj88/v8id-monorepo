        {
          "name": "Delete File (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}?permanent=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{fileId}}"],
              "query": [
                {
                  "key": "permanent",
                  "value": "true",
                  "description": "If true, permanently deletes the file from storage."
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Restore File",
          "request": {
            "method": "POST",
