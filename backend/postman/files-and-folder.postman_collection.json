{
  "info": {
    "_postman_id": "files-folder-collection",
    "name": "Files and Folders",
    "description": "Endpoints for managing files and folders in v8id-cloud.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Folders",
      "item": [
        {
          "name": "Create Folder (Root)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"New Project\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"]
            }
          },
          "response": []
        },
        {
          "name": "Create Folder (Nested)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Sub Folder\",\n    \"parentId\": \"{{folderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"]
            }
          },
          "response": []
        },
        {
          "name": "List Root Contents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of items to skip"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Sub-Folder Contents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders?parentId={{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"],
              "query": [
                {
                  "key": "parentId",
                  "value": "{{folderId}}"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of items to skip"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload File (Root)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "Upload File (To Folder)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "folderId",
                  "value": "{{folderId}}",
                  "type": "text"
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search All",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=Project&type=all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "Project"
                },
                {
                  "key": "type",
                  "value": "all"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search Folders Only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=Project&type=folder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "Project"
                },
                {
                  "key": "type",
                  "value": "folder"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Full Sync",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sync"]
            },
            "description": "Fetches all files and folders (Initial load)."
          },
          "response": []
        },
        {
          "name": "Delta Sync (Timestamp)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sync?since=1715000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sync"],
              "query": [
                {
                  "key": "since",
                  "value": "1715000000000",
                  "description": "Timestamp in milliseconds"
                }
              ]
            },
            "description": "Fetches only changes since the given timestamp."
          },
          "response": []
        },
        {
          "name": "Delta Sync (ETag)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "If-None-Match",
                "value": "\"ETAG_FROM_PREVIOUS_RESPONSE\"",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sync"]
            },
            "description": "Uses ETag to check for changes. Returns 304 if no changes."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "folderId",
      "value": "",
      "type": "string"
    }
  ]
}
