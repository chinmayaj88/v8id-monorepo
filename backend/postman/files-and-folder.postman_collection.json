{
  "info": {
    "_postman_id": "files-folder-collection",
    "name": "Files and Folders",
    "description": "Endpoints for managing files and folders in v8id-cloud.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Folders",
      "item": [
        {
          "name": "Create Folder (Root)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"New Project\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"]
            }
          },
          "response": []
        },
        {
          "name": "Create Folder (Nested)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Sub Folder\",\n    \"parentId\": \"{{folderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"]
            }
          },
          "response": []
        },
        {
          "name": "List Root Contents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of items to skip"
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "description": "Optional: STANDARD or ARCHIVE",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Sub-Folder Contents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders?parentId={{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"],
              "query": [
                {
                  "key": "parentId",
                  "value": "{{folderId}}"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of items to skip"
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "description": "Optional: STANDARD or ARCHIVE",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Folder (Soft)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Folder (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}?permanent=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}"],
              "query": [
                {
                  "key": "permanent",
                  "value": "true",
                  "description": "If true, permanently deletes the folder and its contents."
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Restore Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}", "restore"]
            }
          },
          "response": []
        },
        {
          "name": "Share Folder (Internal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"type\": \"INTERNAL\",\n    \"permission\": \"EDIT\",\n    \"email\": \"user@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}", "share"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Initiate Chunked Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data) {",
                  "        pm.environment.set(\"uploadId\", jsonData.data.uploadId);",
                  "        console.log(\"✅ uploadId saved to environment\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fileName\": \"large-video.mp4\",\n    \"mimeType\": \"video/mp4\",\n    \"size\": 52428800,\n    \"folderId\": \"{{folderId}}\",\n    \"tier\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "initiate"]
            }
          },
          "response": []
        },
        {
          "name": "Complete Chunked Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"storageKey\": \"uploads/{{userId}}/{{uploadId}}\",\n    \"fileName\": \"large-video.mp4\",\n    \"mimeType\": \"video/mp4\",\n    \"size\": 52428800,\n    \"folderId\": \"{{folderId}}\",\n    \"tier\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "complete"]
            }
          },
          "response": []
        },
        {
          "name": "Get Storage Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "analytics"]
            }
          },
          "response": []
        },
        {
          "name": "Upload File (Root)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "Upload File (To Folder)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "folderId",
                  "value": "{{folderId}}",
                  "type": "text"
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          },
          "response": []
