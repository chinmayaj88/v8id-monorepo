{
  "info": {
    "_postman_id": "files-folders-collection",
    "name": "Files and Folders",
    "description": "File and folder management endpoints for v8id-cloud.\n\n**Features:**\n- Single/Multiple file upload (up to 100MB)\n- Chunked large file upload (up to 5GB) with pause/resume/cancel\n- Folder operations with tree structure\n- Universal search\n- User access sharing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. File Upload",
      "item": [
        {
          "name": "Single File Upload (up to 100MB)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "File to upload (max 100MB)"
                },
                {
                  "key": "folderId",
                  "value": "",
                  "type": "text",
                  "description": "Optional folder ID to upload into"
                },
                {
                  "key": "name",
                  "value": "",
                  "type": "text",
                  "description": "Optional custom file name"
                },
                {
                  "key": "description",
                  "value": "",
                  "type": "text",
                  "description": "Optional description"
                },
                {
                  "key": "storageTier",
                  "value": "STANDARD",
                  "type": "text",
                  "description": "STANDARD or ARCHIVE"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          }
        },
        {
          "name": "Multiple Files Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Multiple files (max 100MB each)"
                },
                {
                  "key": "folderId",
                  "value": "",
                  "type": "text",
                  "description": "Optional folder ID"
                },
                {
                  "key": "storageTier",
                  "value": "STANDARD",
                  "type": "text",
                  "description": "STANDARD or ARCHIVE"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload-multiple",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload-multiple"]
            }
          }
        },
        {
          "name": "Folder Upload (with tree structure)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Files with webkitRelativePath"
                },
                {
                  "key": "folderStructure",
                  "value": "",
                  "type": "text",
                  "description": "JSON array of folder paths to create"
                },
                {
                  "key": "parentFolderId",
                  "value": "",
                  "type": "text",
                  "description": "Optional parent folder ID"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload-folder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload-folder"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Chunked Upload (up to 5GB)",
      "item": [
        {
          "name": "Initiate Chunked Upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"large-video.mp4\",\n  \"fileSize\": 5368709120,\n  \"mimeType\": \"video/mp4\",\n  \"folderId\": null,\n  \"storageTier\": \"STANDARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "initiate"]
            },
            "description": "Initiate a large file upload (up to 5GB). Returns sessionId and upload URL."
          }
        },
        {
          "name": "Upload Chunk",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "chunk",
                  "type": "file",
                  "src": [],
                  "description": "Chunk data (5MB default)"
                },
                { "key": "chunkNumber", "value": "1", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/chunk/:sessionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", "chunk", ":sessionId"],
              "variable": [{ "key": "sessionId", "value": "{{uploadSessionId}}" }]
            }
          }
        },
        {
          "name": "Resume Upload (Get Progress)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/:sessionId/resume",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ":sessionId", "resume"],
              "variable": [{ "key": "sessionId", "value": "{{uploadSessionId}}" }]
            },
            "description": "Get upload progress for resuming. Returns uploaded chunks and bytes."
          }
        },
        {
          "name": "Complete Chunked Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/:sessionId/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ":sessionId", "complete"],
              "variable": [{ "key": "sessionId", "value": "{{uploadSessionId}}" }]
            },
            "description": "Finalize chunked upload after all chunks are uploaded."
          }
        },
        {
          "name": "Cancel Upload",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/:sessionId/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ":sessionId", "cancel"],
              "variable": [{ "key": "sessionId", "value": "{{uploadSessionId}}" }]
            },
            "description": "Cancel chunked upload and delete partial data."
          }
        }
      ]
    },
    {
      "name": "3. File Operations",
      "item": [
        {
          "name": "List Files (Root or Folder)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files?type=file&folderId=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files"],
              "query": [
                { "key": "type", "value": "file", "description": "file or folder (for tabs)" },
                {
                  "key": "folderId",
                  "value": "",
                  "description": "null/empty for root files (not in any folder)"
                },
                { "key": "page", "value": "1", "disabled": true },
                { "key": "limit", "value": "20", "disabled": true },
                { "key": "orderBy", "value": "createdAt", "disabled": true },
                { "key": "orderDirection", "value": "desc", "disabled": true }
              ]
            },
            "description": "List files at root (folderId empty) or inside a folder."
          }
        },
        {
          "name": "List Folders (Root or Subfolder)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files?type=folder&parentId=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files"],
              "query": [
                { "key": "type", "value": "folder", "description": "file or folder (for tabs)" },
                { "key": "parentId", "value": "", "description": "null/empty for root folders" }
              ]
            },
            "description": "List folders at root (parentId empty) or inside a parent folder."
          }
        },
        {
          "name": "Get File Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "{{fileId}}" }]
            }
          }
        },
        {
          "name": "Download File",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "download"],
              "variable": [{ "key": "id", "value": "{{fileId}}" }]
            },
            "description": "Returns presigned URL for direct download."
          }
        },
        {
          "name": "Update File",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"renamed-file.txt\",\n  \"description\": \"Updated description\",\n  \"folderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "{{fileId}}" }]
            }
          }
        },
        {
          "name": "Delete File (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id"],
              "variable": [{ "key": "id", "value": "{{fileId}}" }]
            },
            "description": "Moves file to trash."
          }
        },
        {
          "name": "Permanent Delete File",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "permanent"],
              "variable": [{ "key": "id", "value": "{{fileId}}" }]
            },
            "description": "Permanently delete from trash and OCI storage."
          }
        },
        {
          "name": "Restore File from Trash",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/:id/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ":id", "restore"],
              "variable": [{ "key": "id", "value": "{{fileId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Folder Operations",
      "item": [
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Folder\",\n  \"parentId\": null,\n  \"description\": \"Folder description\",\n  \"color\": \"#FF5733\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders"]
            }
          }
        },
        {
          "name": "Get Folder Contents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/contents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "contents"],
              "variable": [{ "key": "id", "value": "{{folderId}}" }]
            },
            "description": "Get folder contents with files and subfolders."
          }
        },
        {
          "name": "Get Folder Path (Breadcrumbs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/path",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "path"],
              "variable": [{ "key": "id", "value": "{{folderId}}" }]
            },
            "description": "Get full path from root to current folder for breadcrumb navigation."
          }
        },
        {
          "name": "Update Folder",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed Folder\",\n  \"color\": \"#33FF57\",\n  \"parentId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id"],
              "variable": [{ "key": "id", "value": "{{folderId}}" }]
            }
          }
        },
        {
          "name": "Delete Folder (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id"],
              "variable": [{ "key": "id", "value": "{{folderId}}" }]
            }
          }
        },
        {
          "name": "Permanent Delete Folder",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "permanent"],
              "variable": [{ "key": "id", "value": "{{folderId}}" }]
            },
            "description": "Permanently delete folder and all contents."
          }
        },
        {
          "name": "Restore Folder from Trash",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/folders/:id/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "folders", ":id", "restore"],
              "variable": [{ "key": "id", "value": "{{folderId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "5. Search",
      "item": [
        {
          "name": "Universal Search (Files & Folders)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/search?q=test&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "search"],
              "query": [
                { "key": "q", "value": "test", "description": "Search query" },
                { "key": "limit", "value": "20", "description": "Max results" }
              ]
            },
            "description": "Search across all files and folders. Returns ranked results."
          }
        }
      ]
    },
    {
      "name": "6. Sharing",
      "item": [
        {
          "name": "Search Users (for sharing)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/users/search?q=john@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "users", "search"],
              "query": [
                { "key": "q", "value": "john@example.com", "description": "Email to search" }
              ]
            },
            "description": "Search users by email for sharing. Returns minimal user info."
          }
        },
        {
          "name": "Share File/Folder by Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"file-id-here\",\n  \"folderId\": null,\n  \"email\": \"user@example.com\",\n  \"permission\": \"VIEW\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "share"]
            },
            "description": "Share a file or folder with another user. Permissions: VIEW, EDIT"
          }
        },
        {
          "name": "List My Shares",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/shares",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "shares"]
            },
            "description": "List all files/folders I've shared with others."
          }
        },
        {
          "name": "List Shared with Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/shared-with-me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "shared-with-me"]
            },
            "description": "List all files/folders shared with me by others."
          }
        },
        {
          "name": "Remove Share",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/shares/:shareId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "shares", ":shareId"],
              "variable": [{ "key": "shareId", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "7. Trash",
      "item": [
        {
          "name": "List Trash (Files & Folders)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/trash",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "trash"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "fileId", "value": "", "type": "string" },
    { "key": "folderId", "value": "", "type": "string" },
    { "key": "uploadSessionId", "value": "", "type": "string" }
  ]
}
