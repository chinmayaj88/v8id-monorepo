              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{fileId}}", "restore"]
            }
          },
          "response": []
