{
  "info": {
    "_postman_id": "files-folder-collection",
    "name": "Files and Folders",
    "description": "Endpoints for managing files and folders in v8id-cloud.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Folders",
      "item": [
        {
          "name": "Create Folder (Root)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "New Project",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"]
            }
          },
          "response": []
        },
        {
          "name": "Create Folder (Nested)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Sub Folder",
                  "type": "text"
                },
                {
                  "key": "parentId",
                  "value": "{{folderId}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"]
            }
          },
          "response": []
        },
        {
          "name": "List Root Contents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of items to skip"
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "description": "Optional: STANDARD or ARCHIVE",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Sub-Folder Contents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders?parentId={{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders"],
              "query": [
                {
                  "key": "parentId",
                  "value": "{{folderId}}"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of items to skip"
                },
                {
                  "key": "tier",
                  "value": "STANDARD",
                  "description": "Optional: STANDARD or ARCHIVE",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Folder (Soft)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Folder (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}?permanent=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}"],
              "query": [
                {
                  "key": "permanent",
                  "value": "true",
                  "description": "If true, permanently deletes the folder and its contents."
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Restore Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}", "restore"]
            }
          },
          "response": []
        },
        {
          "name": "Share Folder (Internal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "INTERNAL",
                  "type": "text"
                },
                {
                  "key": "permission",
                  "value": "EDIT",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "user@example.com",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "folders", "{{folderId}}", "share"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "1. Initiate Upload (Single or Batch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data && jsonData.data[0]) {",
                  "        const firstFile = jsonData.data[0];",
                  "        pm.environment.set(\"ociUploadId\", firstFile.ociUploadId);",
                  "        pm.environment.set(\"storageKey\", firstFile.storageKey);",
                  "        console.log(\"✅ ociUploadId and storageKey saved from first batch item\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Select File 1"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Select File 2 (Optional)"
                },
                {
                  "key": "folderId",
                  "value": "{{folderId}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "2. Complete Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "storageKey",
                  "value": "{{storageKey}}",
                  "type": "text"
                },
                {
                  "key": "fileName",
                  "value": "large-video.mp4",
                  "type": "text"
                },
                {
                  "key": "mimeType",
                  "value": "video/mp4",
                  "type": "text"
                },
                {
                  "key": "size",
                  "value": "52428800",
                  "type": "text"
                },
                {
                  "key": "ociUploadId",
                  "value": "{{ociUploadId}}",
                  "type": "text"
                },
                {
                  "key": "parts",
                  "value": "[{\"partNumber\":1,\"etag\":\"etag-1\"}]",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "3. Download Files (Single or Batch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\"{{fileId}}\"]\n}",
              "options": {
                "json": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "download"]
            }
          },
          "response": []
        },
        {
          "name": "Get Storage Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "analytics"]
            }
          },
          "response": []
        },
        {
          "name": "Delete File (Soft)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{fileId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete File (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}?permanent=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{fileId}}"],
              "query": [
                {
                  "key": "permanent",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
