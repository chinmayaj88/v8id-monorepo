generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Enums
enum UserRole {
  USER
  ADMIN
}

enum DeviceType {
  MOBILE
  WEB
}

enum FileType {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  OTHER
}

enum FileStatus {
  UPLOADING
  ACTIVE
  DELETED
  ARCHIVED
}

// User Model
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firstName            String?
  lastName             String?
  avatarUrl            String?
  role                 UserRole  @default(USER)
  emailVerified        Boolean   @default(true) // Admin creates verified users
  passwordResetToken   String?
  passwordResetExpires DateTime?
  storageQuota         BigInt    @default(10737418240) // 10GB default
  storageUsed          BigInt    @default(0)
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?

  // TOTP (Two-Factor Authentication) - MANDATORY for all users
  totpSecret   String? // Encrypted TOTP secret (if exists, TOTP is enabled)
  totpVerified Boolean @default(false) // Whether TOTP setup is complete

  // Token versioning - increment on password change to invalidate all tokens
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deviceSessions  DeviceSession[]
  totpBackupCodes TotpBackupCode[]
  auditLogs       AuditLog[]
  files           File[]
  folders         Folder[]

  @@index([email])
  @@index([isActive])
  @@index([role])
  @@map("users")
}

// Device Session Model
model DeviceSession {
  id           String     @id @default(cuid())
  userId       String
  deviceType   DeviceType // MOBILE or WEB
  deviceName   String // User-friendly device name
  deviceId     String // Unique device identifier
  userAgent    String? // Browser/App user agent
  ipAddress    String? // IP address
  location     String? // Approximate location (city, country)
  accessToken  String     @unique @db.VarChar(500) // JWT tokens (typically 200-500 chars)
  refreshToken String     @unique @db.VarChar(500) // JWT tokens (typically 200-500 chars)
  expiresAt    DateTime
  lastActiveAt DateTime   @default(now())
  isActive     Boolean    @default(true)
  isRevoked    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([isActive])
  @@map("device_sessions")
}

// TOTP Backup Codes Model
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  code      String // Hashed backup code
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isUsed])
  @@map("totp_backup_codes")
}

// Audit Log Model - Security event logging
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // Null for system events
  eventType String   // LOGIN, LOGOUT, LOGIN_FAILED, PASSWORD_CHANGE, TOKEN_REFRESH, etc.
  eventData Json?    // Additional event data (IP, device, etc.)
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  errorMessage String?
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([success])
  @@map("audit_logs")
}

// Folder Model - Hierarchical folder structure
model Folder {
  id          String    @id @default(cuid())
  userId      String
  parentId    String?   // Null for root folders
  name        String    @db.VarChar(255)
  description String?   @db.Text
  color       String?   @db.VarChar(7) // Hex color code for UI
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[]  @relation("FolderHierarchy")
  files    File[]

  @@index([userId])
  @@index([parentId])
  @@index([isDeleted])
  @@index([userId, parentId, name]) // For unique folder names per parent
  @@map("folders")
}

// File Model - File metadata and storage info
model File {
  id            String     @id @default(cuid())
  userId        String
  folderId      String?    // Null for files in root
  name          String     @db.VarChar(255) // Display name
  originalName  String     @db.VarChar(500) // Original uploaded filename
  mimeType      String     @db.VarChar(100)
  size          BigInt     // File size in bytes
  type          FileType
  status        FileStatus @default(UPLOADING)
  ociObjectName String     @unique @db.VarChar(500) // OCI Object Storage key
  hash          String     @db.VarChar(64) // SHA-256 hash for deduplication
  description   String?    @db.Text
  tags          Json?      // Array of tags as JSON
  metadata      Json?      // Additional metadata as JSON
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@index([status])
  @@index([type])
  @@index([hash]) // For deduplication lookup
  @@index([userId, folderId, name]) // For unique file names per folder
  @@index([createdAt])
  @@map("files")
}
