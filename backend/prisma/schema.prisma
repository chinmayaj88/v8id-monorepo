generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Enums
enum UserRole {
  USER
  ADMIN
}

enum DeviceType {
  MOBILE
  WEB
}

// User Model
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firstName            String?
  lastName             String?
  avatarPath           String?   @db.VarChar(500) // OCI object path (not the full URL)
  role                 UserRole  @default(USER)
  emailVerified        Boolean   @default(true) // Admin creates verified users
  passwordResetToken   String?
  passwordResetExpires DateTime?
  storageQuota         BigInt    @default(10737418240) // 10GB default
  storageUsed          BigInt    @default(0)
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?

  // TOTP (Two-Factor Authentication) - MANDATORY for all users
  totpSecret   String? // Encrypted TOTP secret (if exists, TOTP is enabled)
  totpVerified Boolean @default(false) // Whether TOTP setup is complete

  // Token versioning - increment on password change to invalidate all tokens
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deviceSessions  DeviceSession[]
  totpBackupCodes TotpBackupCode[]
  auditLogs       AuditLog[]
  folders         Folder[]
  files           File[]
  fileShares      FileShare[]
  folderShares    FolderShare[]

  @@index([email])
  @@index([isActive])
  @@index([role])
  @@map("users")
}

// Device Session Model
model DeviceSession {
  id           String     @id @default(cuid())
  userId       String
  deviceType   DeviceType // MOBILE or WEB
  deviceName   String // User-friendly device name
  deviceId     String // Unique device identifier
  userAgent    String? // Browser/App user agent
  ipAddress    String? // IP address
  location     String? // Approximate location (city, country)
  accessToken  String     @unique @db.VarChar(500) // JWT tokens (typically 200-500 chars)
  refreshToken String     @unique @db.VarChar(500) // JWT tokens (typically 200-500 chars)
  expiresAt    DateTime
  rememberMe   Boolean    @default(false) // Remember Me flag (30-day session, only on first mobile device)
  lastActiveAt DateTime   @default(now())
  isActive     Boolean    @default(true)
  isRevoked    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([isActive])
  @@map("device_sessions")
}

// TOTP Backup Codes Model
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  code      String // Hashed backup code
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isUsed])
  @@map("totp_backup_codes")
}

// Audit Log Model - Security event logging
model AuditLog {
  id           String   @id @default(cuid())
  userId       String? // Null for system events
  eventType    String // LOGIN, LOGOUT, LOGIN_FAILED, PASSWORD_CHANGE, TOKEN_REFRESH, etc.
  eventData    Json? // Additional event data (IP, device, etc.)
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([success])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------
// File & Folder Management System
// ----------------------------------------------------------------------

enum StorageTier {
  STANDARD
  ARCHIVE
}

enum SharePermission {
  VIEW
  EDIT
}

enum ShareType {
  INTERNAL // Shared with another registered user
  PUBLIC_LINK // Shared via public link
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  parentId  String? // Null for root folders
  name      String
  path      String   @db.Text // Materialized path (e.g., /root/documents/work) for efficiency
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Folder?       @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]      @relation("FolderHierarchy")
  files        File[]
  folderShares FolderShare[]

  @@index([userId])
  @@index([parentId])
  @@index([isDeleted])
  @@map("folders")
}

model File {
  id                 String      @id @default(cuid())
  userId             String
  folderId           String? // Null for root files
  name               String
  storageKey         String      @db.VarChar(500) // Path in OCI Bucket
  storageTier        StorageTier @default(STANDARD)
  size               BigInt // Size in bytes
  mimeType           String
  extension          String?
  thumbnailKey       String? // Key for thumbnail in Standard Bucket (if image)
  isDeleted          Boolean     @default(false)
  isOfflineAvailable Boolean     @default(false) // Flag for mobile sync priority
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileShares FileShare[]

  @@index([userId])
  @@index([folderId])
  @@index([storageTier])
  @@index([isDeleted])
  @@map("files")
}

// ----------------------------------------------------------------------
// Sharing System
// ----------------------------------------------------------------------

model FileShare {
  id         String          @id @default(cuid())
  fileId     String
  ownerId    String // User who shared the file
  sharedWith String? // Email of user shared with (for INTERNAL)
  token      String?         @unique // Unique token for public links
  permission SharePermission @default(VIEW)
  type       ShareType       @default(INTERNAL)
  expiresAt  DateTime? // Optional expiration for links
  createdAt  DateTime        @default(now())

  // Relations
  file  File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([ownerId])
  @@index([token])
  @@index([sharedWith])
  @@map("file_shares")
}

model FolderShare {
  id         String          @id @default(cuid())
  folderId   String
  ownerId    String // User who shared the folder
  sharedWith String? // Email of user shared with (for INTERNAL)
  token      String?         @unique // Unique token for public links
  permission SharePermission @default(VIEW)
  type       ShareType       @default(INTERNAL)
  expiresAt  DateTime? // Optional expiration
  createdAt  DateTime        @default(now())

  // Relations
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([ownerId])
  @@index([token])
  @@index([sharedWith])
  @@map("folder_shares")
}
