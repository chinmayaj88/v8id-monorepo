# Server Configuration
PORT=4000
NODE_ENV=development
# CORS Configuration
CORS_ORIGIN=
# Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
DATABASE_URL=
# Email Configuration
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=your

FRONTEND_URL=
# JWT Configuration
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Password Hashing Configuration
BCRYPT_ROUNDS=12
# TOTP (Two-Factor Authentication) Configuration
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=v8id-cloud
# File Upload Configuration
# Maximum file size in bytes (default: 100MB = 104857600)
MAX_FILE_SIZE=104857600
# Allowed file types (use '*' for all types, or comma-separated MIME types)
ALLOWED_FILE_TYPES=*
# Logging Configuration
LOG_LEVEL=debug
#Oci 
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_CONFIG_FILE=C:\Users\jenac\.oci\config
OCI_CONFIG_PROFILE=DEFAULT
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=  
OCI_REGION=
# Storage target
OCI_OBJECT_STORAGE_BUCKET_NAME_STANDARD=
OCI_OBJECT_STORAGE_BUCKET_NAME_ARCHIVE=
# Optional (if key is encrypted)
# OCI_PRIVATE_KEY_PASSPHRASE=your_passphrase
# Trust Proxy Configuration (recommended)
TRUST_PROXY=false
# File Upload Configuration (optional - have defaults)
DIRECT_UPLOAD_THRESHOLD_BYTES=10485760
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_SESSION_EXPIRATION_HOURS=24


hcgc mjcf tpun jqwj
scp -i "path\to\your\ssh_key.key" "C:\Users\jenac\.oci\oci_api_key.pem" opc@YOUR_VM_IP:/opt/v8id-cloud/oci_api_key.pem
